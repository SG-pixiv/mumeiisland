# 무명섬 디스코드 봇 설정 — 이 파일을 .env 로 복사해서 채워요 (cp .env.example .env)
# .env 는 비밀 값이라 깃허브에 올라가지 않아요 (.gitignore)

# 디스코드 개발자 포털 → 무명섬 앱 → Bot → Reset Token 으로 받은 토큰
DISCORD_TOKEN=
# General Information → Application ID
DISCORD_APP_ID=
# 내전 디스코드 서버 ID (디스코드 설정 → 고급 → 개발자 모드 켜기 → 서버 이름 우클릭 → 서버 ID 복사)
DISCORD_GUILD_ID=

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://jesechsptdaijzriikcn.supabase.co
# Secret keys 의 sb_secret_... (절대 공유 금지)
SUPABASE_SECRET_KEY=

SITE_URL=https://mumeiisland.vercel.app
# 공지 · 투표 메시지를 다시 그리는 간격 (분)
REFRESH_MINUTES=3
